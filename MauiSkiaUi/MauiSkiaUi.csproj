<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net10.0;net10.0-android</TargetFrameworks>
		<TargetFrameworks Condition="!$([MSBuild]::IsOSPlatform('linux'))">$(TargetFrameworks);net10.0-ios;net10.0-maccatalyst</TargetFrameworks>
		<TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net10.0-windows10.0.19041.0</TargetFrameworks>

		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>

		<!-- Enable XAML source generation for faster build times and improved performance.
		     This generates C# code from XAML at compile time instead of runtime inflation.
		     To disable, remove this line.
		     For individual files, you can override by setting Inflator metadata:
		       <MauiXaml Update="MyPage.xaml" Inflator="Default" /> (reverts to defaults: Runtime for Debug, XamlC for Release)
		       <MauiXaml Update="MyPage.xaml" Inflator="Runtime" /> (force runtime inflation) -->
		<MauiXamlInflator>SourceGen</MauiXamlInflator>

		<!-- Trimming and Native AOT: marks the assembly trimmable and runs the trim / AOT / single-file analyzers.
		     MAUI turns the trim analyzer off unless the build itself publishes AOT or trims fully (xamarin-macios#21351);
		     opt out of that so every build reports trim warnings, and fail on them. -->
		<IsAotCompatible>true</IsAotCompatible>
		<_MauiDoNotConfigureTrimAnalyzer>true</_MauiDoNotConfigureTrimAnalyzer>
		<EnableTrimAnalyzer>true</EnableTrimAnalyzer>
		<WarningsAsErrors>$(WarningsAsErrors);IL2026;IL2046;IL2050;IL2055;IL2057;IL2058;IL2059;IL2060;IL2062;IL2063;IL2065;IL2067;IL2068;IL2069;IL2070;IL2071;IL2072;IL2073;IL2074;IL2075;IL2076;IL2077;IL2078;IL2079;IL2080;IL2081;IL2082;IL2083;IL2084;IL2085;IL2086;IL2087;IL2088;IL2089;IL2090;IL2091;IL2092;IL2093;IL2094;IL2095;IL2096;IL2097;IL2098;IL2099;IL2103;IL2104;IL2106;IL2111;IL2113;IL2114;IL2115;IL2116;IL2117;IL3000;IL3001;IL3002;IL3003;IL3050;IL3051</WarningsAsErrors>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">21.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
		<TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>

		<!-- NuGet (Version / ApplicationDisplayVersion come from Directory.Build.props) -->
		<IsPackable>true</IsPackable>
		<PackageId>SkiaUi.Maui</PackageId>
		<Authors>Rafal Kukla</Authors>
		<Company>Rafal Kukla</Company>
		<Copyright>Copyright © Rafal Kukla</Copyright>
		<Description>SkiaSharp-drawn .NET MAUI controls and layouts (SkUi*) with GPU-accelerated hosting, XAML composition, and optional native MAUI overlay hosting for Entry, Editor, WebView, and similar.</Description>
		<PackageTags>maui;skiasharp;skia;ui;controls;layouts;gpu;xaml</PackageTags>
		<PackageProjectUrl>https://github.com/rafalka/MauiSkiaUi</PackageProjectUrl>
		<RepositoryUrl>https://github.com/rafalka/MauiSkiaUi</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageIcon>nuget-icon.png</PackageIcon>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<GeneratePackageOnBuild>false</GeneratePackageOnBuild>
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
		<PublishRepositoryUrl>true</PublishRepositoryUrl>
		<!-- Filled by scripts/extract-release-notes.py before pack (see nuget-pack / nuget-publish). -->
		<_ChangelogNotes>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../artifacts/release-notes.txt'))</_ChangelogNotes>
		<PackageReleaseNotes Condition="Exists('$(_ChangelogNotes)')">$([System.IO.File]::ReadAllText('$(_ChangelogNotes)'))</PackageReleaseNotes>
		<EmbedUntrackedSources>true</EmbedUntrackedSources>
	</PropertyGroup>

	<!--
	  Record-frame / scroll-cache probe APIs (ResetDiagnosticRecordStats, ContentPictureRebuilds, …).
	  Off for Release NuGet packs. On in Debug, or when a consumer sets SKUI_ENABLE_DIAGNOSTICS=true
	  (tests pass that via ProjectReference AdditionalProperties).
	-->
	<PropertyGroup Condition="'$(Configuration)' == 'Debug' Or '$(SKUI_ENABLE_DIAGNOSTICS)' == 'true'">
		<DefineConstants>$(DefineConstants);SKUI_DIAGNOSTICS</DefineConstants>
	</PropertyGroup>

	<ItemGroup>
		<None Include="..\README.md" Pack="true" PackagePath="\" />
		<None Include="..\Resources\nuget-icon.png" Pack="true" PackagePath="\" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="MauiSkiaUi.Tests" />
		<InternalsVisibleTo Include="MauiSkiaUiDemo" />
		<InternalsVisibleTo Include="MauiSkiaUi.DeviceTests" />
		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
		<PackageReference Include="SkiaSharp" Version="$(SkiaSharpVersion)" />
		<!-- Text shaping (complex scripts, ligatures, RTL) via HarfBuzz. -->
		<PackageReference Include="SkiaSharp.HarfBuzz" Version="$(SkiaSharpVersion)" />
		<PackageReference Include="SkiaSharp.Views.Maui.Controls" Version="$(SkiaSharpVersion)" Condition="'$(TargetFramework)' != 'net10.0'" />
	</ItemGroup>

</Project>
