<Project Sdk="Microsoft.NET.Sdk">

	<!-- The library's trim / AOT analysis: every analyzer warning is an error here too. -->
	<Import Project="../MauiSkiaUi/TrimAnalysis.props" />

	<PropertyGroup>
		<TargetFrameworks>$(SkUiLibraryTfms)</TargetFrameworks>

		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<RootNamespace>MauiSkiaUi.Markdown</RootNamespace>

		<IsAotCompatible>true</IsAotCompatible>
		<!-- CsWinRT generates unsafe vtable code for types that implement generic WinRT interfaces (e.g. arrays exposed as
		     IReadOnlyList<T>, as the code highlighter's spans) so they stay trim / AOT safe across the WinRT ABI; without unsafe
		     blocks it reports CsWinRT1030. Same as SkiaUi.Maui. -->
		<AllowUnsafeBlocks Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">true</AllowUnsafeBlocks>
		<_MauiDoNotConfigureTrimAnalyzer>true</_MauiDoNotConfigureTrimAnalyzer>
		<EnableTrimAnalyzer>true</EnableTrimAnalyzer>

		<!-- NuGet: released with SkiaUi.Maui, same version (Directory.Build.props); depends on that exact release line. -->
		<IsPackable>true</IsPackable>
		<PackageId>SkiaUi.Maui.Markdown</PackageId>
		<Authors>Rafal Kukla</Authors>
		<Company>Rafal Kukla</Company>
		<Copyright>Copyright © Rafal Kukla</Copyright>
		<Description>A drawn Markdown view for SkiaUi.Maui: headings, lists, tables, code, quotes, alerts, footnotes and images, the same on every platform, without a platform view per paragraph.</Description>
		<PackageTags>maui;skiasharp;skia;ui;markdown;markdig</PackageTags>
		<PackageProjectUrl>https://github.com/rafalka/MauiSkiaUi</PackageProjectUrl>
		<RepositoryUrl>https://github.com/rafalka/MauiSkiaUi</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageIcon>nuget-icon.png</PackageIcon>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<GeneratePackageOnBuild>false</GeneratePackageOnBuild>
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
		<PublishRepositoryUrl>true</PublishRepositoryUrl>
		<_ChangelogNotes>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../artifacts/release-notes.txt'))</_ChangelogNotes>
		<PackageReleaseNotes Condition="Exists('$(_ChangelogNotes)')">$([System.IO.File]::ReadAllText('$(_ChangelogNotes)'))</PackageReleaseNotes>
		<EmbedUntrackedSources>true</EmbedUntrackedSources>
	</PropertyGroup>

	<ItemGroup>
		<None Include="README.md" Pack="true" PackagePath="\" />
		<None Include="..\Resources\nuget-icon.png" Pack="true" PackagePath="\" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="MauiSkiaUi.Tests" />
		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
		<!-- A range: an app can take a newer 1.x of Markdig without a new release here. -->
		<PackageReference Include="Markdig" Version="[$(MarkdigVersion), 2.0.0)" />
		<!-- Packed as a dependency on SkiaUi.Maui of the same version. -->
		<ProjectReference Include="..\MauiSkiaUi\MauiSkiaUi.csproj" />
	</ItemGroup>

</Project>
