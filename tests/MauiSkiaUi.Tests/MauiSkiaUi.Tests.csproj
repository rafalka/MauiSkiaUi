<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- Match library diagnostics so ContentPictureRebuilds / record probes compile in Debug and Release test runs. -->
    <DefineConstants>$(DefineConstants);SKUI_DIAGNOSTICS</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../MauiSkiaUiDemo/ComponentDemoPage.cs" Link="Demo/ComponentDemoPage.cs" />
    <Compile Include="../../MauiSkiaUiDemo/DemoColors.cs" Link="Demo/DemoColors.cs" />
    <Compile Include="../../MauiSkiaUiDemo/DemoAssets.cs" Link="Demo/DemoAssets.cs" />
    <Compile Include="../../MauiSkiaUiDemo/DemoFonts.cs" Link="Demo/DemoFonts.cs" />
    <Compile Include="../../MauiSkiaUiDemo/ComponentPages/**/*.cs" Link="Demo/ComponentPages/%(RecursiveDir)%(Filename)%(Extension)" />
    <!-- Samples app examples (samples/MauiSkiaUiSamples): built and exercised headlessly; sources embedded as in the app. -->
    <Compile Include="../../samples/MauiSkiaUiSamples/Infrastructure/*.cs" Link="Samples/Infrastructure/%(Filename)%(Extension)" />
    <Compile Include="../../samples/MauiSkiaUiSamples/Samples/**/*.cs" Link="Samples/Samples/%(RecursiveDir)%(Filename)%(Extension)" />
    <EmbeddedResource Include="../../samples/MauiSkiaUiSamples/Samples/**/*.cs" Link="Samples/Source/%(RecursiveDir)%(Filename)%(Extension)" LogicalName="SampleSource/%(Filename)%(Extension)" />
    <!-- Leak scenarios shared with the on-device test app (tests/MauiSkiaUi.DeviceTests). -->
    <Compile Include="../Shared/MemoryLeaks/*.cs" Link="Shared/MemoryLeaks/%(Filename)%(Extension)" />
    <None Include="../../MauiSkiaUiDemo/Resources/Fonts/RobotoMono-Regular.ttf" Link="Assets/RobotoMono-Regular.ttf" CopyToOutputDirectory="PreserveNewest" />
    <PackageReference Include="ColorCode.HTML" Version="2.0.15" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0" PrivateAssets="all" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="$(SkiaSharpVersion)" />
    <PackageReference Include="HarfBuzzSharp.NativeAssets.Linux" Version="$(HarfBuzzSharpVersion)" />
    <ProjectReference Include="../../MauiSkiaUi/MauiSkiaUi.csproj" AdditionalProperties="SKUI_ENABLE_DIAGNOSTICS=true" />
  </ItemGroup>
</Project>