<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:sk="clr-namespace:MauiSkiaUi;assembly=MauiSkiaUi"
             x:Class="MauiSkiaUiDemo.MainPage"
             Title="SkiaUi" Background="#FFFFFF" SafeAreaEdges="All">
    <Grid Padding="24" RowDefinitions="Auto,*,Auto,Auto" RowSpacing="20">
        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="4">
            <Label Text="SkiaUi" FontFamily="OpenSansSemibold" FontSize="28"
                   TextColor="#182326" SemanticProperties.HeadingLevel="Level1" />
            <Label Grid.Row="1" Text="Phase 0" FontSize="14" TextColor="#465357" />
            <Label x:Name="AnimationStatus" AutomationId="AnimationStatus"
                   Grid.Column="1" VerticalOptions="Center" Text="Ready"
                   FontSize="14" TextColor="#465357" />
        </Grid>
        <sk:SkUiContentView x:Name="Scene" AutomationId="Scene" Grid.Row="1"
                            MinimumHeightRequest="280" Background="#F1F5F5"
                            SemanticProperties.Description="Animated geometric canvas">
            <sk:SkUiLayout x:Name="SceneLayout" AutomationId="SceneLayout">
                <sk:SkUiBox x:Name="TapBox" AutomationId="TapBox"
                            WidthRequest="112" HeightRequest="112" Margin="24,32,0,0"
                            HorizontalOptions="Start" VerticalOptions="Start"
                            Color="#C54150" Tapped="OnPrimitiveTapped" />
                <sk:SkUiEllipse x:Name="MovingEllipse" AutomationId="MovingEllipse"
                                WidthRequest="100" HeightRequest="100" Margin="0,112,28,0"
                                HorizontalOptions="End" VerticalOptions="Start"
                                Color="#087F83" Tapped="OnPrimitiveTapped" />
                <sk:SkUiLine x:Name="Diagonal" AutomationId="Diagonal"
                             WidthRequest="180" HeightRequest="52" Margin="24,0,0,28"
                             HorizontalOptions="Start" VerticalOptions="End"
                             Color="#263D43" StrokeWidth="5" InputTransparent="True" />
            </sk:SkUiLayout>
        </sk:SkUiContentView>
        <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="16">
            <Label x:Name="TapStatus" AutomationId="TapStatus" Text="Taps: 0"
                   TextColor="#182326" VerticalOptions="Center" FontSize="16" />
            <Button x:Name="AnimateButton" AutomationId="AnimateButton" Grid.Column="1"
                    Text="Animate" Clicked="OnAnimateClicked" Background="#087F83"
                    TextColor="White" CornerRadius="6" Padding="20,12" />
        </Grid>
        <sk:SkUiBox x:Name="SoftwareSample" AutomationId="SoftwareSample" Grid.Row="3"
                    HeightRequest="8" Color="#C54150" />
    </Grid>
</ContentPage>
