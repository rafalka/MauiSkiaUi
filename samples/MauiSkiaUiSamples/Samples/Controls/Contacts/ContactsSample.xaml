<?xml version="1.0" encoding="utf-8" ?>
<!--
  A contacts screen built on SkUiCollectionView: search, sorting and grouping (by letter, by group with contacts in
  several groups, or none) through a live grouped list (LiveGroupedList.cs), list or tile display, a preview next to the
  list on wide screens (a popup on narrow phones), a selection mode (long press) with checkboxes and actions, and a form
  to add contacts. The page fills the screen below its description; the code-behind (ContactsSample.xaml.cs) wires the
  list to the view model (ContactsModel.cs); the views are in ContactViews.cs, the form in ContactEditorPage.cs.
-->
<samples:SamplePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                    xmlns:sk="clr-namespace:MauiSkiaUi;assembly=MauiSkiaUi"
                    xmlns:samples="clr-namespace:MauiSkiaUiSamples"
                    xmlns:local="clr-namespace:MauiSkiaUiSamples.Samples.Controls.Contacts"
                    x:Class="MauiSkiaUiSamples.Samples.Controls.Contacts.ContactsSample"
                    x:DataType="local:ContactsViewModel">

    <samples:SamplePage.Resources>
        <Style x:Key="OptionButton" TargetType="sk:SkUiButton">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="BackgroundColor" Value="{x:Static samples:SampleColors.Surface}" />
            <Setter Property="TextColor" Value="{x:Static samples:SampleColors.Ink}" />
            <Setter Property="BorderColor" Value="{x:Static samples:SampleColors.Border}" />
            <Setter Property="BorderWidth" Value="1" />
        </Style>
    </samples:SamplePage.Resources>

    <!-- One drawn surface for the whole screen; the search box is a native control hosted in it. -->
    <sk:SkUiGrid x:Name="Root" RowDefinitions="Auto,Auto,*" BackgroundColor="{x:Static samples:SampleColors.Page}">

        <!-- Search and add. -->
        <sk:SkUiGrid ColumnDefinitions="*,Auto" ColumnSpacing="8" Padding="12,0,12,6">
            <!-- The search bar's own height: below it, iOS and Mac Catalyst shrink its background but not its field. -->
            <sk:SkUiMauiContentView VerticalOptions="Center">
                <SearchBar Text="{Binding SearchText}" Placeholder="Search name or phone" FontSize="15" />
            </sk:SkUiMauiContentView>
            <sk:SkUiButton Grid.Column="1" Text="+ Add" FontSize="14" Padding="14,8" VerticalOptions="Center" Clicked="OnAdd" />
        </sk:SkUiGrid>

        <!-- Display options (hidden while selecting). -->
        <sk:SkUiGrid x:Name="Options" Grid.Row="1" ColumnDefinitions="Auto,Auto,Auto,*" ColumnSpacing="8" Padding="12,0,12,8">
            <sk:SkUiButton x:Name="GroupingButton" Style="{StaticResource OptionButton}" Clicked="OnGrouping" />
            <sk:SkUiButton x:Name="SortButton" Grid.Column="1" Style="{StaticResource OptionButton}" Clicked="OnSort" />
            <sk:SkUiButton x:Name="DisplayButton" Grid.Column="2" Style="{StaticResource OptionButton}" Clicked="OnDisplay" />
            <sk:SkUiLabel Grid.Column="3" Text="{Binding Status}" FontSize="12" TextColor="{x:Static samples:SampleColors.Caption}"
                          LineBreakMode="TailTruncation" VerticalOptions="Center" />
        </sk:SkUiGrid>

        <!-- Actions on the checked contacts (the selection mode). -->
        <sk:SkUiGrid x:Name="Actions" Grid.Row="1" IsVisible="{Binding IsSelecting}" ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto"
                     ColumnSpacing="6" Padding="12,0,12,8">
            <sk:SkUiButton Text="Done" Style="{StaticResource OptionButton}" Clicked="OnDone" />
            <sk:SkUiLabel Grid.Column="1" Text="{Binding Status}" FontSize="14" FontAttributes="Bold" TextColor="{x:Static samples:SampleColors.Ink}"
                          LineBreakMode="TailTruncation" VerticalOptions="Center" Margin="6,0" />
            <sk:SkUiButton Grid.Column="2" Text="All" Style="{StaticResource OptionButton}" Clicked="OnSelectAll" />
            <sk:SkUiButton Grid.Column="3" Text="★" Style="{StaticResource OptionButton}" Clicked="OnStar" />
            <sk:SkUiButton Grid.Column="4" Text="Group…" Style="{StaticResource OptionButton}" Clicked="OnGroup" />
            <sk:SkUiButton Grid.Column="5" Text="Delete" Style="{StaticResource OptionButton}" BackgroundColor="#C62828" TextColor="White" Clicked="OnDelete" />
        </sk:SkUiGrid>

        <!-- The list, and the preview beside it on wide screens. -->
        <sk:SkUiGrid x:Name="Body" Grid.Row="2" ColumnDefinitions="*,0">
            <sk:SkUiCollectionView x:Name="List" BackgroundColor="{x:Static samples:SampleColors.Surface}"
                                   IsStickyGroupHeader="True" AllowGroupExpandCollapse="True" KeepSelectionVisible="True"
                                   ItemTapped="OnItemTapped">
                <sk:SkUiCollectionView.EmptyView>
                    <sk:SkUiLabel Text="No contacts" FontSize="15" TextColor="{x:Static samples:SampleColors.Caption}"
                                  HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                </sk:SkUiCollectionView.EmptyView>
            </sk:SkUiCollectionView>
            <sk:SkUiBorder x:Name="PreviewPane" Grid.Column="1" IsVisible="False" StrokeThickness="0"
                           BackgroundColor="{x:Static samples:SampleColors.Page}">
                <local:ContactPreview x:Name="Preview" />
            </sk:SkUiBorder>
        </sk:SkUiGrid>

        <!-- The preview as a popup on narrow phones: a tap outside it closes it. -->
        <sk:SkUiGrid x:Name="Popup" Grid.RowSpan="3" IsVisible="False">
            <sk:SkUiBox Color="#66000000" Tapped="OnClosePopup" />
            <sk:SkUiBorder Margin="24" VerticalOptions="Center" StrokeThickness="0" StrokeShape="RoundRectangle 16"
                           BackgroundColor="{x:Static samples:SampleColors.Surface}">
                <sk:SkUiBorder.Shadow>
                    <Shadow Brush="Black" Opacity="0.25" Radius="16" Offset="0,4" />
                </sk:SkUiBorder.Shadow>
                <sk:SkUiGrid>
                    <local:ContactPreview x:Name="PopupPreview" />
                    <sk:SkUiButton Text="✕" FontSize="14" Padding="10,4" Margin="8" HorizontalOptions="End" VerticalOptions="Start"
                                   BackgroundColor="Transparent" TextColor="{x:Static samples:SampleColors.Caption}" Clicked="OnClosePopup" />
                </sk:SkUiGrid>
            </sk:SkUiBorder>
        </sk:SkUiGrid>
    </sk:SkUiGrid>

</samples:SamplePage>
