<Project>
  <PropertyGroup>
    <!--
      Two .NET lines (net10.0-* with MAUI 10, net11.0-* with MAUI 11) in every package. The per-line pins below are picked for
      each target framework further down ($(MauiVersion), $(CommunityToolkitMauiVersion), $(MicrosoftExtensionsVersion)).
      Inner builds get $(TargetFramework) as a global property, so it is known here; the outer build gets the net10 values.
    -->
    <!-- Microsoft.Maui.Controls (and the MAUI workload's implicit packages). net10 stays at its floor: apps may use any later 10.x. -->
    <Maui10Version>10.0.120</Maui10Version>
    <Maui11Version>11.0.10</Maui11Version>

    <!-- Pin SkiaSharp and its companion packages (HarfBuzz, Views, native assets) via $(SkiaSharpVersion); keep them in lockstep. One
         version for both lines: SkiaSharp.Views.Maui.Controls has net10 assets only, which net11 builds use on MAUI 11. -->
    <SkiaSharpVersion>4.154.0</SkiaSharpVersion>
    <!-- CommunityToolkit.Maui for SkiaUi.Maui.CommunityToolkit, the demo, the samples and the tests: 15.x is the last net10 line,
         17.x targets net11 only. -->
    <CommunityToolkitMaui10Version>15.0.1</CommunityToolkitMaui10Version>
    <CommunityToolkitMaui11Version>17.0.0</CommunityToolkitMaui11Version>
    <!-- Microsoft.Extensions.* packages the apps reference directly (the demo's Logging.Debug). -->
    <MicrosoftExtensions10Version>10.0.13</MicrosoftExtensions10Version>
    <MicrosoftExtensions11Version>11.0.0</MicrosoftExtensions11Version>
    <!-- Markdig for SkiaUi.Maui.Markdown; CSharpMath.Rendering for SkiaUi.Maui.Markdown.Math. -->
    <MarkdigVersion>1.6.0</MarkdigVersion>
    <CSharpMathVersion>0.5.1</CSharpMathVersion>
    <!-- HarfBuzzSharp version SkiaSharp.HarfBuzz $(SkiaSharpVersion) depends on (for the Linux native assets of headless projects). -->
    <HarfBuzzSharpVersion>14.2.1.400</HarfBuzzSharpVersion>

    <!--
      Shared product version for SkiaUi.Maui NuGet (PackageVersion/Version) and the demo app
      (ApplicationDisplayVersion). Override on the CLI with -p:Version=… (pack/publish workflows).
    -->
    <Version>1.10.3</Version>
    <!-- Numeric x.y.z only (Windows / iOS reject SemVer prerelease suffixes): strip "-Prerelease…". -->
    <ApplicationDisplayVersion>$(Version.Split('-')[0])</ApplicationDisplayVersion>
    <!-- Android versionCode / iOS CFBundleVersion (integer); bump when shipping store builds. -->
    <ApplicationVersion>1</ApplicationVersion>
  </PropertyGroup>

  <!--
    Target frameworks, used by every project instead of its own list:
      SkUiLibraryTfms   the packages: netX.0 (headless tests) plus the platform TFMs
      SkUiAppTfms       app heads with a Windows build (demo, samples)
      SkUiDeviceTfms    app heads without one (device tests, on-device bench)
      SkUiHeadlessTfms  plain netX.0 projects (headless tests, benchmark runner)
    Each list has net11 first, so a tool that picks the first TFM runs .NET 11. iOS and Mac Catalyst are left out on Linux, Windows
    is only built on Windows. -p:SkUiNet=10 or -p:SkUiNet=11 builds one line only; SDK 10, which can't build net11.0, builds the
    net10 line by itself.
    App heads (SkUiAppTfms, SkUiDeviceTfms) build net10 iOS and Mac Catalyst on SDK 10 only: SDK 11's workload carries the net10
    Apple packs for Xcode 26 (26.0.x), which refuse to build an app with a newer Xcode, while SDK 10's own workload has the Xcode 27
    packs .NET 10 apps use. Libraries are not affected (no Xcode check), so the packages build every TFM on SDK 11. The SDK's major
    version comes from MSBuild's path (empty under Visual Studio's own MSBuild, which then keeps every TFM).
  -->
  <PropertyGroup>
    <_SkUiSdkMajor>$([System.Text.RegularExpressions.Regex]::Match('$(MSBuildBinPath)', '[/\\]sdk[/\\](\d+)\.').Groups[1].Value)</_SkUiSdkMajor>
    <SkUiNet Condition="'$(SkUiNet)' == '' and '$(_SkUiSdkMajor)' == '10'">10</SkUiNet>
    <_SkUiNet11 Condition="'$(SkUiNet)' != '10'">true</_SkUiNet11>
    <_SkUiNet10 Condition="'$(SkUiNet)' != '11'">true</_SkUiNet10>
    <_SkUiApple Condition="!$([MSBuild]::IsOSPlatform('linux'))">true</_SkUiApple>
    <_SkUiWindows Condition="$([MSBuild]::IsOSPlatform('windows'))">true</_SkUiWindows>

    <_SkUiDevice11 Condition="'$(_SkUiNet11)' == 'true'">net11.0-android</_SkUiDevice11>
    <_SkUiDevice11 Condition="'$(_SkUiNet11)' == 'true' and '$(_SkUiApple)' == 'true'">$(_SkUiDevice11);net11.0-ios;net11.0-maccatalyst</_SkUiDevice11>
    <_SkUiDevice10 Condition="'$(_SkUiNet10)' == 'true'">net10.0-android</_SkUiDevice10>
    <_SkUiApple10 Condition="'$(_SkUiNet10)' == 'true' and '$(_SkUiApple)' == 'true'">net10.0-ios;net10.0-maccatalyst</_SkUiApple10>
    <_SkUiApple10Apps Condition="'$(_SkUiSdkMajor)' == '' or '$(_SkUiSdkMajor)' == '10'">$(_SkUiApple10)</_SkUiApple10Apps>
    <_SkUiWin11 Condition="'$(_SkUiNet11)' == 'true' and '$(_SkUiWindows)' == 'true'">net11.0-windows10.0.19041.0</_SkUiWin11>
    <_SkUiWin10 Condition="'$(_SkUiNet10)' == 'true' and '$(_SkUiWindows)' == 'true'">net10.0-windows10.0.19041.0</_SkUiWin10>
    <_SkUiHeadless11 Condition="'$(_SkUiNet11)' == 'true'">net11.0</_SkUiHeadless11>
    <_SkUiHeadless10 Condition="'$(_SkUiNet10)' == 'true'">net10.0</_SkUiHeadless10>

    <!-- Joined with ';' and trimmed (empty segments dropped); unescaped, as MSBuild escapes the ';' in a property function's result. -->
    <SkUiHeadlessTfms>$([MSBuild]::Unescape($([System.Text.RegularExpressions.Regex]::Replace('$(_SkUiHeadless11);$(_SkUiHeadless10)', ';{2,}', ';').Trim(';'))))</SkUiHeadlessTfms>
    <SkUiDeviceTfms>$([MSBuild]::Unescape($([System.Text.RegularExpressions.Regex]::Replace('$(_SkUiDevice11);$(_SkUiDevice10);$(_SkUiApple10Apps)', ';{2,}', ';').Trim(';'))))</SkUiDeviceTfms>
    <SkUiAppTfms>$([MSBuild]::Unescape($([System.Text.RegularExpressions.Regex]::Replace('$(_SkUiDevice11);$(_SkUiWin11);$(_SkUiDevice10);$(_SkUiApple10Apps);$(_SkUiWin10)', ';{2,}', ';').Trim(';'))))</SkUiAppTfms>
    <SkUiLibraryTfms>$([MSBuild]::Unescape($([System.Text.RegularExpressions.Regex]::Replace('$(SkUiHeadlessTfms);$(_SkUiDevice11);$(_SkUiWin11);$(_SkUiDevice10);$(_SkUiApple10);$(_SkUiWin10)', ';{2,}', ';').Trim(';'))))</SkUiLibraryTfms>
  </PropertyGroup>

  <!--
    -p:SkUiPlatforms=ios+maccatalyst (joined by "+", as "," and ";" split -p values: android, ios, maccatalyst, windows) keeps only those platforms' TFMs in the
    lists, for CI jobs that build one platform: restore then needs no other workload (NETSDK1147), without a TargetFrameworks
    override (an escaped list on the command line reaches the inner builds as one TFM, NETSDK1046). Plain netX.0 is left out.
  -->
  <PropertyGroup Condition="'$(SkUiPlatforms)' != ''">
    <_SkUiDropTfm>(?&lt;=;)net\d+\.\d+(?:-(?!(?:$(SkUiPlatforms.Replace('+', '|')))\b)[a-z]+[\d.]*)?(?=;)</_SkUiDropTfm>
    <SkUiHeadlessTfms>$([MSBuild]::Unescape($([System.Text.RegularExpressions.Regex]::Replace($([System.Text.RegularExpressions.Regex]::Replace(';$(SkUiHeadlessTfms);', '$(_SkUiDropTfm)', '')), ';{2,}', ';').Trim(';'))))</SkUiHeadlessTfms>
    <SkUiDeviceTfms>$([MSBuild]::Unescape($([System.Text.RegularExpressions.Regex]::Replace($([System.Text.RegularExpressions.Regex]::Replace(';$(SkUiDeviceTfms);', '$(_SkUiDropTfm)', '')), ';{2,}', ';').Trim(';'))))</SkUiDeviceTfms>
    <SkUiAppTfms>$([MSBuild]::Unescape($([System.Text.RegularExpressions.Regex]::Replace($([System.Text.RegularExpressions.Regex]::Replace(';$(SkUiAppTfms);', '$(_SkUiDropTfm)', '')), ';{2,}', ';').Trim(';'))))</SkUiAppTfms>
    <SkUiLibraryTfms>$([MSBuild]::Unescape($([System.Text.RegularExpressions.Regex]::Replace($([System.Text.RegularExpressions.Regex]::Replace(';$(SkUiLibraryTfms);', '$(_SkUiDropTfm)', '')), ';{2,}', ';').Trim(';'))))</SkUiLibraryTfms>
  </PropertyGroup>

  <!-- Per-TFM pins and minimum OS versions (MAUI 11 raised Android to API 24; the others are the same on both lines). -->
  <PropertyGroup>
    <_SkUiTfmVersion Condition="'$(TargetFramework)' != ''">$([MSBuild]::GetTargetFrameworkVersion('$(TargetFramework)', 2))</_SkUiTfmVersion>
    <_SkUiTfmPlatform Condition="'$(TargetFramework)' != ''">$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)'))</_SkUiTfmPlatform>

    <MauiVersion>$(Maui10Version)</MauiVersion>
    <CommunityToolkitMauiVersion>$(CommunityToolkitMaui10Version)</CommunityToolkitMauiVersion>
    <MicrosoftExtensionsVersion>$(MicrosoftExtensions10Version)</MicrosoftExtensionsVersion>
    <MauiVersion Condition="'$(_SkUiTfmVersion)' == '11.0'">$(Maui11Version)</MauiVersion>
    <CommunityToolkitMauiVersion Condition="'$(_SkUiTfmVersion)' == '11.0'">$(CommunityToolkitMaui11Version)</CommunityToolkitMauiVersion>
    <MicrosoftExtensionsVersion Condition="'$(_SkUiTfmVersion)' == '11.0'">$(MicrosoftExtensions11Version)</MicrosoftExtensionsVersion>

    <SupportedOSPlatformVersion Condition="'$(_SkUiTfmPlatform)' == 'ios'">15.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="'$(_SkUiTfmPlatform)' == 'maccatalyst'">17.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="'$(_SkUiTfmPlatform)' == 'android'">21.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="'$(_SkUiTfmPlatform)' == 'android' and '$(_SkUiTfmVersion)' == '11.0'">24.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="'$(_SkUiTfmPlatform)' == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion Condition="'$(_SkUiTfmPlatform)' == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
  </PropertyGroup>

  <!--
    API check (scripts/api_compat.sh): -p:SkUiApiBaseline=<released version> turns on the SDK's package validation for pack.
    It compares the package with that release from nuget.org (nothing public may be removed in 1.x) and each framework in the
    package with the newer ones it is compatible with (net10.0-ios with net11.0-ios: net11 drops nothing net10 has; not strict,
    since the platform TFMs add platform types to net10.0 / net11.0 by design). A pack holds the TFMs its OS builds, so the
    baseline's frameworks this pack has no TFM for are left out (the pack on the other OS compares them). '%2A' is a literal
    wildcard for the SDK's framework filter (a bare '*' in Include is a file glob and matches nothing).
  -->
  <PropertyGroup Condition="'$(SkUiApiBaseline)' != ''">
    <EnablePackageValidation>true</EnablePackageValidation>
    <PackageValidationBaselineVersion>$(SkUiApiBaseline)</PackageValidationBaselineVersion>
  </PropertyGroup>
  <ItemGroup Condition="'$(SkUiApiBaseline)' != ''">
    <PackageValidationBaselineFrameworkToIgnore Include="net10.0" Condition="!$([System.String]::new(';$(TargetFrameworks);').Contains(';net10.0;'))" />
    <PackageValidationBaselineFrameworkToIgnore Include="net10.0-android%2A" Condition="!$(TargetFrameworks.Contains('net10.0-android'))" />
    <PackageValidationBaselineFrameworkToIgnore Include="net10.0-ios%2A" Condition="!$(TargetFrameworks.Contains('net10.0-ios'))" />
    <PackageValidationBaselineFrameworkToIgnore Include="net10.0-maccatalyst%2A" Condition="!$(TargetFrameworks.Contains('net10.0-maccatalyst'))" />
    <PackageValidationBaselineFrameworkToIgnore Include="net10.0-windows%2A" Condition="!$(TargetFrameworks.Contains('net10.0-windows'))" />
  </ItemGroup>
</Project>
